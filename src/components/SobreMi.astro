---
import BrowStrokes from "./BrowStrokes.astro";
import Lineas from "./Lineas.astro";
import { Image } from "astro:assets";
// Textos editables desde el panel /admin (Sobre mí)
import raw from "../data/sobre-mi.json";
import { lista, parrafos, txt } from "../lib/texto";
const s: any = raw;

const retratoImgs = import.meta.glob("../assets/laura-retrato.{jpg,jpeg,png,webp,avif}", {
  eager: true,
  import: "default",
});
const retratoImg = Object.values(retratoImgs)[0] as any;
const fotoAlt = txt(s.foto_descripcion) || "Laura Mora";
const garantias = lista<string>(s.garantias).map((g) => txt(g)).filter(Boolean);
---

<section class="sobre section" id="sobre-mi">
  <div class="wrap sobre__grid">
    <div class="sobre__media">
      <div class="portrait" role="img" aria-label={fotoAlt}>
        {retratoImg
          ? <Image src={retratoImg} alt={fotoAlt} class="portrait__photo" widths={[400, 600, 800, 1000, 1400]} quality={95} sizes="(max-width: 820px) 320px, 32vw" />
          : <span class="frame__hint">Retrato de Laura</span>}
      </div>
    </div>

    <div class="sobre__text">
      {txt(s.etiqueta) && <p class="kicker">{s.etiqueta}</p>}
      {txt(s.titulo) && <h2><Lineas text={s.titulo} /></h2>}

      {parrafos(s.texto).map((p) => <p>{p}</p>)}

      <div class="sobre__mark" aria-hidden="true">
        <BrowStrokes variant="mark" />
      </div>

      {garantias.length > 0 && (
        <ul class="garantias">
          {garantias.map((g) => <li>{g}</li>)}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .sobre__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .portrait {
    aspect-ratio: 3 / 4;
    border-radius: 8px;
    background: radial-gradient(130% 100% at 30% 20%, var(--blush), var(--shell-2) 75%);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    position: sticky;
    top: 6rem;
    overflow: hidden;
  }
  .portrait__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame__hint { font-size: var(--step--1); color: var(--taupe); letter-spacing: 0.04em; }

  .sobre__text h2 { margin: 1rem 0 1.5rem; }
  .sobre__text p { color: var(--ink-soft); margin-bottom: 1.15rem; }

  .sobre__mark { width: 3.5rem; margin: 1.75rem 0 1.25rem; color: var(--rose); }

  .garantias {
    display: grid;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }
  .garantias li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ink);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .garantias li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--sage);
    border-radius: 50%;
  }

  @media (max-width: 820px) {
    .sobre__grid { grid-template-columns: 1fr; }
    .sobre__media { max-width: 320px; }
    .portrait { position: relative; top: auto; }
  }
</style>
