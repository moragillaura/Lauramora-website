---
const links = [
  { href: "#que-es", label: "Qué es" },
  { href: "#proceso", label: "El proceso" },
  { href: "#servicios", label: "Servicios" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#testimonios", label: "Opiniones" },
  { href: "#preguntas", label: "Preguntas" },
];
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href="#top" class="mark" aria-label="Laura Mora, inicio">
      <span class="mark__name">Laura Mora</span>
      <span class="mark__sub">Estética y micropigmentación</span>
    </a>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Abrir menú"
    >
      <span class="nav__burger" aria-hidden="true"></span>
    </button>

    <nav class="nav__menu" id="nav-menu" aria-label="Navegación principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a href="#reservar" class="btn btn--solid nav__cta">Reservar</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--shell) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }
  .mark { display: grid; line-height: 1.05; }
  .mark__name {
    font-family: var(--serif);
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }
  .mark__sub {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--taupe);
    text-transform: lowercase;
  }

  /* ---- Menu: fila horizontal en escritorio ---- */
  .nav__menu {
    display: flex;
    gap: clamp(1rem, 2vw, 2.2rem);
    font-size: var(--step--1);
    letter-spacing: 0.01em;
  }
  .nav__menu a {
    color: var(--ink-soft);
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: color .25s ease, border-color .25s ease;
  }
  .nav__menu a:hover { color: var(--ink); border-color: var(--rose); }
  .nav__cta { padding: 0.6rem 1.3rem; }

  /* ---- Boton hamburguesa: aparece solo en movil ---- */
  .nav__toggle {
    display: none;
    order: 3;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: border-color .25s ease;
  }
  .nav__toggle:hover { border-color: var(--ink); }

  .nav__burger,
  .nav__burger::before,
  .nav__burger::after {
    display: block;
    width: 17px;
    height: 1px;
    background: var(--ink);
    transition: transform .3s ease, background-color .2s ease;
  }
  .nav__burger::before,
  .nav__burger::after { content: ""; position: relative; }
  .nav__burger::before { top: -6px; }
  .nav__burger::after { top: 5px; }

  /* Abierto: los tres trazos se cruzan en aspa. */
  .nav__toggle[aria-expanded="true"] .nav__burger { background: transparent; }
  .nav__toggle[aria-expanded="true"] .nav__burger::before {
    top: 1px;
    transform: rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] .nav__burger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 860px) {
    .nav__toggle { display: inline-flex; }

    /* El menu pasa a panel desplegable bajo la cabecera.
       Se oculta con una clase, no con el atributo `hidden`: asi sigue
       existiendo para los lectores de pantalla en escritorio. */
    .nav__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      gap: 0;
      background: var(--shell);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 12px 24px -18px rgb(43 54 72 / 0.45);
      padding: 0.25rem var(--gutter) 1rem;
      font-size: var(--step-0);
    }
    .nav.is-open .nav__menu { display: grid; }
    .nav__menu a {
      padding: 0.95rem 0;
      border-bottom: 1px solid var(--line);
    }
    .nav__menu a:last-child { border-bottom: 0; }
  }

  @media (max-width: 520px) {
    .nav__cta { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".nav");
  const toggle = header?.querySelector<HTMLButtonElement>(".nav__toggle");
  const menu = header?.querySelector<HTMLElement>("#nav-menu");

  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      header.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Al elegir una seccion el panel se cierra solo.
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    // Si se vuelve a escritorio con el panel abierto, se reinicia el estado.
    window
      .matchMedia("(min-width: 861px)")
      .addEventListener("change", (e) => {
        if (e.matches) setOpen(false);
      });
  }
</script>
