---
// Contenido editable desde el panel /admin
import testimoniosData from "../data/testimonios.json";
const testimonios = testimoniosData.items;
---

<section class="testi section" id="testimonios">
  <div class="wrap">
    <header class="testi__head">
      <p class="kicker">Lo que dicen mis clientas</p>
      <h2>Confían en mí para<br />algo tan visible como su cara.</h2>
    </header>

    <div class="testi__grid">
      {testimonios.map((t) => (
        <figure class="quote">
          <span class="quote__mark" aria-hidden="true">&rdquo;</span>
          <blockquote>{t.texto}</blockquote>
          <figcaption>
            <span class="quote__name">{t.nombre}</span>
            {t.detalle && <span class="quote__detail">{t.detalle}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testi {
    background:
      radial-gradient(120% 140% at 100% 0%, var(--blush), transparent 55%),
      var(--shell);
  }
  .testi__head { max-width: 60ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .testi__head h2 { margin-top: 1rem; }

  .testi__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .quote {
    position: relative;
    margin: 0;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 4px 4px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .quote__mark {
    font-family: var(--serif);
    font-size: 3.5rem;
    line-height: 0.4;
    color: var(--rose);
    height: 1.4rem;
  }
  .quote blockquote {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--step-1);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .quote figcaption {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .quote__name { font-size: var(--step-0); }
  .quote__detail { font-size: var(--step--1); color: var(--taupe); letter-spacing: 0.02em; }

  @media (max-width: 820px) {
    .testi__grid { grid-template-columns: 1fr; max-width: 520px; }
  }
</style>
