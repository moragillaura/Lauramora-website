---
// Contenido editable desde el panel /admin (General y Contacto)
import contacto from "../data/contacto.json";
import raw from "../data/general.json";
import { txt } from "../lib/texto";
const g: any = raw;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      {txt(g.marca_nombre) && <span class="footer__name">{g.marca_nombre}</span>}
      {txt(g.pie_subtitulo) && <span class="footer__sub">{g.pie_subtitulo}</span>}
    </div>

    <nav class="footer__links" aria-label="Enlaces legales">
      <a href="#que-es" class="tlink">Qué es</a>
      <a href="#servicios" class="tlink">Servicios</a>
      <a href="#reservar" class="tlink">Reservar</a>
      <a href="#aviso-legal" class="tlink">Aviso legal</a>
    </nav>
  </div>

  <div class="wrap footer__foot">
    {txt(contacto.registro_sanitario) && <p>{contacto.registro_sanitario}</p>}
    <p>© {year} {g.marca_nombre}. {g.pie_derechos}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--shell-2);
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
    border-top: 1px solid var(--line);
  }
  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .footer__brand { display: grid; }
  .footer__name { font-family: var(--serif); font-size: var(--step-2); }
  .footer__sub { font-size: var(--step--1); color: var(--taupe); letter-spacing: 0.06em; }
  .footer__links { display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: var(--step--1); }

  .footer__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    font-size: 0.78rem;
    color: var(--taupe);
  }
  .footer__foot p { max-width: none; }
</style>
