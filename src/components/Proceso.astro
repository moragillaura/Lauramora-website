---
import Lineas from "./Lineas.astro";
// Textos editables desde el panel /admin (El proceso)
import raw from "../data/proceso.json";
import { lista, txt } from "../lib/texto";
const p: any = raw;
// El número de cada paso (01, 02…) se pone solo, según el orden.
const steps = lista<any>(p.pasos).filter((s) => txt(s.titulo) || txt(s.texto));
---

<section class="proceso section" id="proceso">
  <div class="wrap">
    <header class="proceso__head">
      {txt(p.etiqueta) && <p class="kicker">{p.etiqueta}</p>}
      {txt(p.titulo) && <h2><Lineas text={p.titulo} /></h2>}
      {txt(p.texto) && <p class="proceso__note">{p.texto}</p>}
    </header>

    {steps.length > 0 && (
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step__n">{String(i + 1).padStart(2, "0")}</span>
            <div class="step__main">
              {txt(s.titulo) && <h3>{s.titulo}</h3>}
              {txt(s.texto) && <p>{s.texto}</p>}
            </div>
            <span class="step__time">{s.duracion}</span>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .proceso__head { max-width: 60ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .proceso__head h2 { margin: 1rem 0 1.25rem; }
  .proceso__note { color: var(--ink-soft); }

  .steps { display: grid; gap: 0; }
  .step {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: clamp(1rem, 4vw, 3rem);
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-top: 1px solid var(--line);
  }
  .step:last-child { border-bottom: 1px solid var(--line); }

  .step__n {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--rose);
    line-height: 1;
  }
  .step__main h3 { margin-bottom: 0.5rem; }
  .step__main p { color: var(--ink-soft); max-width: 52ch; }
  .step__time {
    font-size: var(--step--1);
    color: var(--taupe);
    letter-spacing: 0.05em;
    white-space: nowrap;
    padding-top: 0.4rem;
  }

  @media (max-width: 640px) {
    .step { grid-template-columns: 3rem 1fr; }
    .step__n { font-size: var(--step-1); }
    .step__time { grid-column: 2; padding-top: 0.75rem; }
  }
</style>
