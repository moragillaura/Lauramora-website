---
import Lineas from "./Lineas.astro";
// Textos editables desde el panel /admin (Qué es)
import raw from "../data/que-es.json";
import { lista, parrafos, txt } from "../lib/texto";
const q: any = raw;
const facts = lista<any>(q.puntos).filter((f) => txt(f.titulo) || txt(f.texto));
---

<section class="que section" id="que-es">
  <div class="wrap que__grid">
    <div class="que__intro">
      {txt(q.etiqueta) && <p class="kicker">{q.etiqueta}</p>}
      {txt(q.titulo) && <h2><Lineas text={q.titulo} /></h2>}
    </div>

    <div class="que__body">
      {parrafos(q.texto).map((p) => <p>{p}</p>)}

      {facts.length > 0 && (
        <dl class="que__facts">
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.titulo}</dt>
              <dd>{f.texto}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</section>

<style>
  .que { background: var(--shell-2); }
  .que__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .que__intro h2 { color: var(--ink); }
  .que__body p { margin-bottom: 1.25rem; color: var(--ink-soft); }

  .que__facts {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }
  .fact { border-top: 1px solid var(--line); padding-top: 0.9rem; }
  .fact dt {
    font-family: var(--serif);
    font-size: var(--step-1);
    margin-bottom: 0.35rem;
  }
  .fact dd {
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .que__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .que__facts { grid-template-columns: 1fr; }
  }
</style>
