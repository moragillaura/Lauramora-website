---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Laura Mora · Estética y micropigmentación en Sevilla",
  description = "Centro de micropigmentación en Sevilla. Micropigmentación natural y resultados realistas: microblading, laminado de cejas, lifting de pestañas, faciales bajo diagnóstico y presoterapia. Formaciones presenciales y online.",
} = Astro.props;

// La URL canonica sale de `site` (astro.config.mjs, y --site en el workflow
// de GitHub Pages). Nunca se escribe un dominio a mano aqui.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1ea" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />

    <!-- Fonts: Cormorant Garamond (display, echoes her signage) + Jost (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
